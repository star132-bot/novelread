# Copy to .env on the server and fill in. Never commit the real file.
DATABASE_URL=postgresql://mkread:CHANGE_ME@DB_HOST:5432/mkread
DATA_DIR=/data
# Public HTTPS origin of this server (MKauth redirects back to PUBLIC_BASE_URL/api/v1/auth/callback)
PUBLIC_BASE_URL=https://books.mkauth.sbs
OIDC_ISSUER=https://auth.mkauth.sbs
# MKauth confidential web client for this server
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# login = every request needs a signed-in device; public = anyone can browse/download
READ_ACCESS=login
# MKauth "sub" values allowed to publish (comma separated); users with role mkread:admin also can
ADMIN_SUBJECTS=
# For publishing from scripts or the web admin page; generate with: openssl rand -hex 32
ADMIN_API_TOKEN=
MAX_UPLOAD_MB=200
