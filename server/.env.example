# Copy to .env on the server and fill in. Never commit the real file.
DATABASE_URL=postgresql://mkread:CHANGE_ME@DB_HOST:5432/mkread
DATA_DIR=/data
# Public HTTPS origin of this server (MKauth redirects back to PUBLIC_BASE_URL/api/v1/auth/callback)
PUBLIC_BASE_URL=https://books.mkauth.sbs
OIDC_ISSUER=https://auth.mkauth.sbs
# MKauth confidential web client for this server
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# login = every request needs a signed-in device; public = anyone can browse/download
READ_ACCESS=login
# MKauth "sub" values that are always superadmins of the admin console (/admin), comma separated.
# Other admins get a role in the console or from MKauth (mkread:viewer / mkread:operator / mkread:admin).
ADMIN_SUBJECTS=
# For scripts calling the publishing and admin APIs (acts as superadmin); generate with: openssl rand -hex 32
ADMIN_API_TOKEN=
# Trusted platforms calling the admin API for their signed-in people, as name:role:token (comma separated).
# Requests must carry X-Admin-Actor (who) and may carry X-Admin-Actor-Name (percent-encoded).
ADMIN_SERVICE_TOKENS=
MAX_UPLOAD_MB=200
